{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js", "${CLAUDE_PLUGIN_ROOT}"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
